# Bearer token Cursor sends on every tool call. Generate a long random string.
BRIDGE_TOKEN=

# Your personal WhatsApp, country code included, no plus: 15551234567
# Messages are sent here. The account you link by QR must be a different number.
WHATSAPP_TO=

PORT=3872

# How long whatsapp_ask blocks before returning pending, in seconds. Max 240.
ASK_WAIT_SECONDS=180
